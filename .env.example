# Add your AbhiBots API key here for local development.
# For Vercel, add ABHIBOTS_API_KEY in Project Settings > Environment Variables.
# Never put API keys in vercel.json or commit them.
ABHIBOTS_API_KEY=
# Optional. Defaults to NVIDIA Nemotron Ultra through AbhiBots.
ABHIBOTS_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
# Optional. Defaults to the AbhiBots API endpoint.
ABHIBOTS_BASE_URL=https://opus.abhibots.com/v1

# Optional until account sign-in is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
